# Admin — copy file này thành .env
# API base URL (Backend). Mặc định chạy local:
REACT_APP_API_URL=http://localhost:3100/api/
# REACT_APP_API_URL2 — key cũ trong .env, hiện không còn file nào trong Admin/src dùng tới.
# Nếu cần API phụ thì bỏ comment và điền URL:
# REACT_APP_API_URL2=https://example.com/api
