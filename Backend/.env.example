# Backend — copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env lên Git.
# CẢNH BÁO: các secret cũ (DB password, JWT key, SMTP Brevo, PayPal Sandbox)
# đã từng lộ trên repo public — PHẢI xoay (tạo mới) trước khi dùng ở production.
# Không dùng lại bất kỳ giá trị nào từng xuất hiện trong code/repo cũ.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=goalguard

# Server
PORT=3100
CORS_ORIGINS=http://localhost:3000,http://localhost:3005,http://localhost:3500

# JWT — bắt buộc đổi ở production (key cũ đã lộ)
JWT_ACCESS_KEY=doi-key-moi-o-day

# SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# PayPal (mặc định Sandbox; production đổi PAYPAL_API_BASE sang api.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api.sandbox.paypal.com

# Frontend URLs — dùng cho link reset password
CLIENT_URL=http://localhost:3500
ADMIN_URL=http://localhost:3000
